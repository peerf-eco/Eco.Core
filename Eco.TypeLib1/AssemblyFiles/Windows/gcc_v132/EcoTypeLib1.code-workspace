		"configurations": [
			{
				"name": "DEBUG: EcoTypeLib1UnitTest Static|x86",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder:BuildFiles}/Windows/x86/StaticDebug/EcoTypeLib1.exe",
				"cwd": "${workspaceFolder:BuildFiles}/Windows/x86/StaticDebug",
				"preLaunchTask": "build EcoTypeLib1UnitTest StaticDebug|x86",
				"MIMode": "gdb",
